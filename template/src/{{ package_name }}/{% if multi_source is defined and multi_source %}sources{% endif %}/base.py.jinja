"""Template-method base for a pluggable source adapter. Each concrete `sources/<key>/source.py`
subclasses this and fills in the three abstract hooks; `search()`/`fetch_detail()` are implemented
once here and shared by every source."""

from abc import ABC, abstractmethod
from typing import Protocol

from {{ package_name }}.models import Result


class Fetcher(Protocol):
    """What a source adapter needs from a fetcher — satisfied structurally by whichever concrete
    fetcher this repo generated with (core.fetch.PoliteFetcher or
    core.fetch_browser.PoliteBrowserFetcher), so this module never imports a module that only
    exists for one fetch strategy."""

    def fetch(self, url: str) -> str: ...


class SourceAdapter(ABC):
    _fetcher: Fetcher

    def __init__(self, fetcher: Fetcher) -> None:
        self._fetcher = fetcher

    def search(self, query: str) -> list[Result]:
        url = self._build_query(query)
        html = self._fetcher.fetch(url)
        return self._parse_results(html)

    def fetch_detail(self, url: str) -> Result:
        html = self._fetcher.fetch(url)
        return self._parse_detail(html, url=url)

    @abstractmethod
    def _build_query(self, query: str) -> str: ...

    @abstractmethod
    def _parse_results(self, html: str) -> list[Result]: ...

    @abstractmethod
    def _parse_detail(self, html: str, *, url: str) -> Result: ...
