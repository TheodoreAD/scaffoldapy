target-version = "py311"
line-length = 120

[lint]
# Same curated select as power-user-linux-setup/repo-tasks (the origin this config was extracted
# from) — see repo-tasks' own ruff.toml for the full per-rule-group rationale; kept in sync by hand.
select = [
  "E4",
  "E7",
  "E9",
  "F",
  "E501",
  "I",
  "UP",
  "B",
  "C4",
  "SIM",
  "PTH",
  "RET",
  "TID",
  "RUF",
  "C90",
  "PERF",
  "A",
  "DTZ",
  "PL",
  "TRY",
]
ignore = [
  "PLR", # refactor-suggestion noise (too-many-args/branches/statements, magic-value-comparison),
  # not bug-catching — see repo-tasks' ruff.toml for the research trail
  "TRY003", # "raise vanilla exception with a long message" — deliberately minimal exception
  # hierarchy in a small package
]

[lint.isort]
known-first-party = ["{{ package_name }}"]
section-order = ["future", "standard-library", "third-party", "first-party", "local-folder"]
