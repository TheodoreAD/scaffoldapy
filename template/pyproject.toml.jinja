{#- Collected up front rather than emitted by a chain of inline {%- if -%} blocks: the `library`
    interface takes none of them, and dprint formats an empty array as `[]`, not as `[` + `]` on two
    lines -- a shape the inline form can't express without the whitespace control fighting itself. -#}
{%- set deps = (
  (["fastmcp"] if interface in ("mcp_server", "skill") else [])
  + (["typer"] if interface == "cli" else [])
  + (["fastapi", "uvicorn[standard]"] if interface == "web_service" else [])
  + (["httpx", "tenacity", "diskcache"] if fetch_strategy | default("none") == "http" else [])
  + (["playwright"] if fetch_strategy | default("none") == "browser_session" else [])
) -%}
[project]
name = "{{ package_name | replace('_', '-') }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">=3.11"
{% if deps -%}
dependencies = [
{%- for dep in deps %}
  "{{ dep }}",
{%- endfor %}
]
{%- else -%}
dependencies = []
{%- endif %}

{% if interface == "mcp_server" -%}
[project.scripts]
{{ package_name }} = "{{ package_name }}.server:main"
{% elif interface == "cli" -%}
[project.scripts]
{{ package_name }} = "{{ package_name }}.cli:app"
{% endif -%}

{#- Deliberately NOT the `dependencies = []` shape above, even though an empty dev group looks
    identical: `repo-tasks configs.ensure-deps` fills this group in at generation time by
    splicing `  "<dep>",\n` lines in right after the `[` (a regex insert, not a TOML rewrite), so
    it needs the bracket pair already spread across two lines. Collapse this to `dev = []` and
    ensure-deps produces `dev = [  "basedpyright...",` — which dprint then rejects, failing the
    generated repo's very first `inv quality.check`. Confirmed live 2026-08-23. -#}
[dependency-groups]
dev = [
{%- if interface == "web_service" %}
  "httpx", # FastAPI's TestClient needs it even when fetch_strategy doesn't already pull it in
{%- endif %}
]
{%- if with_docs %}
docs = [
  "zensical",
]
{%- endif %}

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]
