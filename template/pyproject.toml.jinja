{#- Collected up front rather than emitted by a chain of inline {%- if -%} blocks: the `library`
    interface takes none of them, and dprint formats an empty array as `[]`, not as `[` + `]` on two
    lines -- a shape the inline form can't express without the whitespace control fighting itself.
    typing-extensions: `typing_extensions.override` on the SourceAdapter hooks -- `typing.override`
    is 3.12+ and the 3.11 floor is the default. Kept for the 3.14 floor too, so the generated code
    has one import path rather than two. -#}
{%- set deps = (
  (["fastmcp"] if interface in ("mcp_server", "skill") else [])
  + (["typer"] if interface == "cli" else [])
  + (["fastapi", "uvicorn[standard]"] if interface == "web_service" else [])
  + (["httpx", "tenacity", "diskcache"] if fetch_strategy | default("none") == "http" else [])
  + (["playwright"] if fetch_strategy | default("none") == "browser_session" else [])
  + (["typing-extensions"] if multi_source | default(false) else [])
) -%}
[project]
name = "{{ package_name | replace('_', '-') }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">={{ python_floor }}"
{% if deps -%}
dependencies = [
{%- for dep in deps %}
  "{{ dep }}",
{%- endfor %}
]
{%- else -%}
dependencies = []
{%- endif %}

{% if interface == "mcp_server" -%}
[project.scripts]
{{ package_name }} = "{{ package_name }}.server:main"
{% elif interface == "cli" -%}
[project.scripts]
{{ package_name }} = "{{ package_name }}.cli:app"
{% endif -%}

[dependency-groups]
dev = [
{%- if interface == "web_service" %}
  # FastAPI's TestClient needs a client even when fetch_strategy doesn't already pull one in, and
  # starlette now wants httpx2: given plain httpx it still works, but raises
  # StarletteDeprecationWarning at import of starlette.testclient — which the shared pytest.ini's
  # `filterwarnings = error` turns into a collection error, so the generated repo's gate fails out
  # of the box. httpx2 is upstream's own answer, and starlette prefers it when present.
  "httpx2",
{% endif -%}
]
{%- if with_docs %}
docs = [
  "zensical",
]
{%- endif %}

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]
