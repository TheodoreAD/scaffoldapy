name: Deploy docs

on:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-latest
    # Scoped to the one job that needs it, rather than inherited from the workflow-level grant
    # above: actions-gh-pages pushes the built site to the gh-pages branch.
    permissions:
      contents: write
    steps:
      # persist-credentials: false is safe even though this job publishes — actions-gh-pages pushes
      # with the token handed to it below, never with the credentials the checkout would otherwise
      # leave behind (.git/config through checkout v5, a separate file from v6). zizmor's artipacked
      # audit runs in the generated repo's own gate.
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@v9.0.0
      - run: ./bootstrap-repo-tasks.sh
      - run: inv dev-env.setup
      # repo-tasks' venv.sync has no --group passthrough, so the docs group needs one raw uv call
      # on top of dev-env.setup's own sync. --locked matches every other sync in the family: a
      # stale/missing uv.lock fails loudly instead of being silently rewritten.
      - run: uv sync --locked --group docs
      - run: inv docs.build
      - uses: peaceiris/actions-gh-pages@v4
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_dir: ./site
